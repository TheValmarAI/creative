# Copy to .env; add your Pydantic AI Gateway key from Logfire's Gateway settings.
AI_MODEL=gateway/openai-responses:gpt-6-luna
PYDANTIC_AI_GATEWAY_API_KEY=
# Optional region override; normally inferred from your Gateway key.
# PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
# Optional role overrides (Node 0 and workflow planning both use PLANNER_MODEL).
# PLANNER_MODEL=gateway/openai-responses:gpt-6.1-sol
# GENERATOR_MODEL=gateway/openai-responses:gpt-6-luna
# WRITER_MODEL=gateway/openai-responses:gpt-6.1-sol
# No OpenAI/provider key is required by this app for Gateway model strings.
# The Gateway account must have the chosen upstream model/provider configured.

# Native Pydantic Logfire observability. --verbose also shows Logfire spans locally.
# A Logfire write token is separate from the Gateway key; omit it for console-only traces.
LOGFIRE_ENABLED=true
# LOGFIRE_TOKEN=
# LOGFIRE_INCLUDE_CONTENT=true
# Content capture defaults to false: traces include timing/usage/errors, not prompts/outputs.

# For an OpenAI Chat Completions-compatible endpoint, use openai-chat: models
# for every role. AI_API_KEY is only for this custom endpoint.
# AI_MODEL=openai-chat:your-model
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=

# Omit API_TOKEN only for localhost development. Use a long random secret otherwise.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# API_TOKEN=
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
ALLOWED_ORIGINS=[]

# Candidates per node, including frameworks (1–100). Override with CLI --candidate-count
# or API/MCP candidate_count. Environment variables override .env; requests override both.
CANDIDATE_COUNT=20

MAX_LLM_CALLS=8
MAX_GENERATIONS=4
CALL_TIMEOUT_SECONDS=180
GENERATION_TIMEOUT_SECONDS=600
TRANSIENT_RETRIES=2
